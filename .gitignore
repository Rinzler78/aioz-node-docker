# Node data folder of docker-compose.yml (NODEDATA_PATH=./nodedata): holds the
# wallet private key.
/nodedata/
# A wallet key or a compose environment file, wherever it is copied.
privkey*.json
.env
# Worktrees of the branches being worked on.
/.worktrees/
# State of the delivery watch, kept next to the script when run from here.
/host/*.state*
