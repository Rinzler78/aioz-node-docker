{
  "version": "0.2",
  "language": "en",
  "ignoreRegExpList": [
    "GitHubNodeId",
    "AiozAddress"
  ],
  "patterns": [
    {
      "name": "GitHubNodeId",
      "pattern": "/\\b[A-Z]{1,3}_k[a-z][A-Za-z0-9_-]{6,}/g"
    },
    {
      "name": "AiozAddress",
      "pattern": "/\\baioz1[02-9ac-hj-np-z]{38}\\b/g"
    }
  ],
  "ignorePaths": [
    ".git/**",
    ".worktrees/**"
  ],
  "words": [
    "adduser",
    "aioz",
    "aioznetwork",
    "aioznode",
    "aiozworker",
    "attoaioz",
    "bech",
    "commitish",
    "depin",
    "Dockerfiles",
    "esac",
    "gcompat",
    "gsub",
    "healthcheck",
    "ignorefile",
    "keytool",
    "laddr",
    "nodedata",
    "pgrep",
    "pkill",
    "privkey",
    "quicktest",
    "rinzler",
    "rinzlerfr",
    "shellcheck",
    "shfmt",
    "softprops",
    "trivyignore",
    "worktrees",
    "zipball"
  ],
  "ignoreWords": [
    "Onizuka",
    "phongcojxuong",
    "Tuan",
    "tuantq",
    "Voron"
  ]
}
