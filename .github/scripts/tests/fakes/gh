#!/bin/bash
# Fake gh: `api <endpoint>` answers from $FAKE_GH_DIR/<endpoint with / as _>.json
# (query string ignored), like gh: error JSON on stdout and exit 1 when missing.
# `issue list|create|comment` use $FAKE_GH_DIR/tracking-issue (author in
# tracking-issue-author, app/github-actions if missing) and log to calls;
# `issue view` applies --jq to the tracking issue JSON, $FAKE_GH_DIR/tracking-view.json
# (an issue with no report when missing).
case "$1" in
    api)
        endpoint="${2%%\?*}"
        file="$FAKE_GH_DIR/${endpoint//\//_}.json"
        jq_expr=""
        shift 2
        while [ $# -gt 0 ]; do
            [ "$1" = "--jq" ] && jq_expr="$2" && shift
            shift
        done
        if [ ! -f "$file" ]; then
            cat "$FIXTURES/error-404.json"
            echo "gh: Not Found (HTTP 404)" >&2
            exit 1
        fi
        if [ -n "$jq_expr" ]; then jq -r "$jq_expr" "$file"; else cat "$file"; fi
        ;;
    issue)
        case "$2" in
            list)
                # --author must match the issue author (default: the workflow token).
                author=$(cat "$FAKE_GH_DIR/tracking-issue-author" 2> /dev/null || echo app/github-actions)
                for arg in "$@"; do
                    [ "$prev" = "--author" ] && [ "$arg" != "$author" ] && exit 0
                    prev="$arg"
                done
                cat "$FAKE_GH_DIR/tracking-issue" 2> /dev/null || true
                ;;
            view)
                jq_expr=""
                while [ $# -gt 0 ]; do
                    [ "$1" = "--jq" ] && jq_expr="$2" && shift
                    shift
                done
                view="$FAKE_GH_DIR/tracking-view.json"
                [ -f "$view" ] || view="$FIXTURES/tracking-issue-empty.json"
                jq -r "$jq_expr" "$view"
                ;;
            create) echo "create" >> "$FAKE_GH_DIR/calls" ;;
            comment) echo "comment $3" >> "$FAKE_GH_DIR/calls" ;;
        esac
        ;;
esac
